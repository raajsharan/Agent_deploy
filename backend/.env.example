# ============================================================
# Copy this file to .env and fill in your real values.
# Never commit the real .env file to source control.
# ============================================================

# --- Server ---
PORT=4000
# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:4000

# --- Login sessions ---
# A long random string, fixed and secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, a random one is generated at each server start, which means
# everyone gets logged out whenever the server restarts.
SESSION_SECRET=
# Set to true once you're serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Session lifetime in milliseconds (default 12 hours).
SESSION_MAX_AGE_MS=43200000

# --- Inventory API (your custom internal tool) ---
INVENTORY_API_URL=https://inventory.yourcompany.local/api/v1/servers
INVENTORY_AUTH_HEADER=Authorization
INVENTORY_AUTH_SCHEME=Bearer
# Option A: static API key/token (leave INVENTORY_LOGIN_URL/USERNAME/PASSWORD blank)
INVENTORY_API_TOKEN=changeme
# Option B: username/password login flow (leave INVENTORY_API_TOKEN blank) -
# used when the inventory API issues a short-lived token (e.g. a JWT) from a
# login endpoint instead of a fixed key. The token is cached and refreshed
# automatically before it expires.
INVENTORY_LOGIN_URL=
INVENTORY_USERNAME=
INVENTORY_PASSWORD=
# Field names in the inventory API's JSON response - adjust to match your schema
INVENTORY_FIELD_HOSTNAME=hostname
INVENTORY_FIELD_IP=ip_address
INVENTORY_FIELD_OS=os
# Only rows whose OS field contains this string are treated as deployment targets
INVENTORY_OS_FILTER=Windows Server
# Page size to request if the API paginates results (ignored for a flat array response)
INVENTORY_PAGE_SIZE=200

# --- ManageEngine Endpoint Central API ---
# Adjust the base URL and auth flow to match your Endpoint Central version/deployment.
# Cloud instances and on-prem instances use different base URLs and auth token endpoints.
EC_BASE_URL=https://your-endpointcentral-server:8383
EC_API_KEY=changeme
EC_AUTH_HEADER=Authorization
EC_AUTH_SCHEME=Bearer
# Endpoint/path that lists managed computers - confirm against your EC API docs/version
EC_COMPUTERS_PATH=/api/1.4/am/computers

# --- Deployment execution ---
# Path (on the machine running this backend) to the Endpoint Central agent installer
INSTALLER_LOCAL_PATH=C:\Deploy\EndpointCentralAgent.msi
# Fallback credential, only used for a target server whose inventory record
# has no asset_username/password on file (see fetchAssetPassword in
# inventoryService.js - per-asset inventory credentials take precedence when
# present). Path to a PSCredential exported via Export-Clixml, see
# backend/scripts/Setup-Credential.ps1.
DEPLOY_CREDENTIAL_FILE=C:\Deploy\deploy-credential.xml
# Max number of servers to deploy to at the same time
MAX_CONCURRENT_DEPLOYMENTS=5
